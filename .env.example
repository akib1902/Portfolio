# ── Site ──────────────────────────────────────────────────────────────────────
# Public origin used for canonical URLs, sitemap.xml, and robots.txt.
# Example: https://akibahmed.dev
SITE_URL=

# Port the Express server listens on.
PORT=3000

# Set to 1 when running behind a reverse proxy (nginx, Render, Fly, etc.)
# so rate limiting sees the real client IP. Leave blank for direct hosting.
TRUST_PROXY=

# ── Contact form ──────────────────────────────────────────────────────────────
# Where form submissions are written (defaults to ./data).
DATA_DIR=./data

# Optional: deliver each submission by email. All four values must be set.
CONTACT_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: friendly "from" header for notification email.
SMTP_FROM=Portfolio Contact <no-reply@example.com>
