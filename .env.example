# ── Site ──────────────────────────────────────────────────────────────────────
# Public origin used for canonical URLs, sitemap.xml, and robots.txt.
# Example: https://akibahmed.dev
SITE_URL=

# Port the Express server listens on.
PORT=3000
# Use 0.0.0.0 when running inside a container or on a hosting platform.
HOST=127.0.0.1

# Set to 1 when running behind a reverse proxy (nginx, Render, Fly, etc.)
# so rate limiting sees the real client IP. Leave blank for direct hosting.
TRUST_PROXY=

# ── Contact form ──────────────────────────────────────────────────────────────
# Where form submissions are written (defaults to ./data).
DATA_DIR=./data

# Optional: deliver each submission by email. All four values must be set.
CONTACT_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: friendly "from" header for notification email.
SMTP_FROM=Portfolio Contact <no-reply@example.com>

# ── Content database (admin CMS) ─────────────────────────────────────────────
# SQLite file. Keep DATA_DIR (or this path) on a persistent disk: content edits
# and the admin account live here and will be lost on an ephemeral filesystem.
DATABASE_PATH=./data/portfolio.db

# Uploaded portrait, project, and social images. Must also be persistent.
UPLOAD_DIR=./data/uploads

# Administrator session lifetime in hours (1–72, default 8).
SESSION_TTL_HOURS=8

# ── Administrator provisioning ───────────────────────────────────────────────
# Used only by `npm run admin:create`. Never commit real values. No default
# credentials are shipped, and there is no public registration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
