{
  "name": "akib-ahmed-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Amber Minimal editorial portfolio for Akib Ahmed — full-stack, DevOps, and QA engineer.",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "messages": "tsx server/read-messages.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/anton": "^5.2.8",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "nodemailer": "^7.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
